# Copy this file to ".env" and fill in your real values.
# Never commit ".env" — it is listed in .gitignore.

# PostgreSQL (CivicConnect backend)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=civicconnect
DB_USER=civicconnect
DB_PASSWORD=change-me
DB_SSL=false
# Optional: override the full JDBC URL instead of HOST/PORT/NAME/SSL
# DB_JDBC_URL=jdbc:postgresql://localhost:5432/civicconnect

# Spring profile: "postgres" for real DB, "demo" for in-memory H2
SPRING_PROFILES_ACTIVE=postgres

# Demo accounts (RISK-004). Off by default; always on for the "demo" profile.
# To use them with PostgreSQL locally, switch them on and choose your own password.

# DEMO_USERS_ENABLED=true
# DEMO_PASSWORD=choose-a-local-password
# Server
SERVER_PORT=8081

# Frontend (Vite reads only variables that start with VITE_)
VITE_API_BASE_URL=/api/v1

# Optional: extra browser origins for CORS (comma-separated). Same-origin staging can omit.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# E2E / performance against staging (never commit real secrets)
# STAGING_BASE_URL=https://civicconnect-staging.onrender.com
# PERF_ITERATIONS=10
